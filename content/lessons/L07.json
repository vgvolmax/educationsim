      "id": "air",
      "title": "Локальная пробка",
      "template": "direct"
    },
    {
      "id": "dirty",
      "title": "Засор общего участка",
      "template": "direct"
    },
    {
      "id": "clear",
      "title": "Обслуживание",
      "template": "direct"
    }
  ],
  "actions": [
