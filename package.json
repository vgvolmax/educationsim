{
  "name": "educationsim",
  "productName": "EducationSim",
  "version": "0.1.0",
  "private": true,
  "description": "Offline Volmax hydronic underfloor heating trainer",
  "main": ".vite/build/main.cjs",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "electron-forge start",
    "dev:web": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=web",
    "build": "vite build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "package:win": "electron-forge make --platform=win32 --arch=x64",
    "test:desktop": "playwright test --project=desktop",
    "catalog:validate": "node scripts/validate-catalog.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-vite": "8.0.1",
    "@electron-forge/shared-types": "8.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "electron": "45.5.0",
    "eslint": "9.39.4",
    "fake-indexeddb": "6.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
